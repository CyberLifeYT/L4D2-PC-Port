# vscript dispatch-table workaround (see fix_vscript_table.cmake):
# vscript exports L4d2VscriptLookup; every other module's indirect-call
# fallback imports it.
if(TARGET l4d2_vscript_360)
  target_sources(l4d2_vscript_360 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/stubs/vscript_lookup.cpp")
  foreach(_m client_360 datacache_360 engine_360 filesystem_stdio_360 gameui_360 inputsystem_360 launcher_360 matchmaking_360 materialsystem_360 scenefilecache_360 server_360 shaderapidx9_360 soundemittersystem_360 stdshader_dx9_360 studiorender_360 tier0_360 vgui2_360 vguimatsurface_360 vphysics_360 vstdlib_360)
    if(TARGET l4d2_${_m})
      target_link_libraries(l4d2_${_m} PRIVATE l4d2_vscript_360)
    endif()
  endforeach()
endif()

